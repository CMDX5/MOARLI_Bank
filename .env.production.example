# ============================================
# MOARLI Bank — Production Environment
# ============================================
# Copy this file to .env.local (development) or .env.production (production)
# NEVER commit real values to Git!
# NEVER push this file to any public repository!

# ── Firebase Client SDK (NEXT_PUBLIC_ = exposed to browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Sentry Error Monitoring ──
NEXT_PUBLIC_SENTRY_DSN="https://your-key@sentry.io/0"

# ── Admin Access (SERVER-SIDE ONLY — never use NEXT_PUBLIC_ prefix) ──
ADMIN_EMAIL="admin@morali.bank"
# Generate bcrypt hash: node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('YourSecurePassword',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH="$2a$12$..."

# ── Firebase Admin SDK ──
# REQUIRED for Vercel / serverless deployments.
# Generate: cat service-account-key.json | jq -c . | tr -d '\n'
# Then paste the output as the value below (single line, no spaces):
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Alternative (local dev only — do NOT use on Vercel):
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
# Option 2 (RECOMMENDED for production): Inline JSON string — set via your hosting platform secrets manager
# Generate: cat service-account-key.json | jq -c . | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── Admin Bootstrap Token (one-time use — delete after first admin account is created!) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Remove this variable from your environment after the first admin is registered!
ADMIN_BOOTSTRAP_TOKEN="your_random_64_char_hex_bootstrap_token"

# ── Card PIN Encryption (SERVER-SIDE ONLY) ──
# Master key for server-side PIN encryption/decryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MORALI_PIN_MASTER_KEY="your_64_char_hex_master_key"

# ── Webhook HMAC Secret (SERVER-SIDE ONLY) ──
# Used to verify payment provider webhook signatures
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET="your_random_64_char_hex_secret"

# ── Email (Resend) ──
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="noreply@morali.bank"

# ── SMS (Twilio) ──
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
SMS_API_KEY="your_sms_api_key"

# ── Development / Debug Flags (set to "true" to enable) ──
# WARNING: These flags are HARD-BLOCKED in production (NODE_ENV=production) regardless of their value.
# They are only effective in development mode. Do NOT set them to "true" in any production config.
ALLOW_INSECURE_AUTH="false"
ALLOW_DEMO_OTP="false"

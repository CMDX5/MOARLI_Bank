generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String   @unique
  avatar    String?
  pin       String
  role      String   @default("user") // user, merchant, agent, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]
  cards        VirtualCard[]
  goals        SavingsGoal[]
  cagnottes    Cagnotte[]
  cagnotteContributions CagnotteContribution[]
  budgets      Budget[]
  badges       UserBadge[]
  tontinesCreated Tontine[]
  tontines     TontineMember[]
  payLinks     PayLink[]
  credits      Credit[]
  receipts     Receipt[]
  notifications Notification[]
  merchantProfile MerchantProfile?
  agentProfile   AgentProfile?
  onboardingComplete Boolean @default(false)
  savingsRoundUp Boolean @default(false)
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  currency  String   @default("XAF") // XAF, EUR, USD
  label     String   @default("Portefeuille principal")
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  type        String   // deposit, withdrawal, transfer, payment, credit, qr_payment
  amount      Float
  currency    String   @default("XAF")
  status      String   @default("completed") // pending, completed, failed, queued
  description String?
  category    String?  // food, transport, mobile_money, services, transfers, health, education, entertainment
  reference   String   @unique
  recipientPhone String?
  recipientName  String?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  receipt Receipt?
}

model VirtualCard {
  id          String   @id @default(cuid())
  userId      String
  last4       String
  maskedNumber String
  expiry      String
  type        String   @default("one_time") // one_time, recurring
  amountLimit Float
  amountUsed  Float    @default(0)
  status      String   @default("active") // active, expired, blocked, used
  validUntil  DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model SavingsGoal {
  id          String   @id @default(cuid())
  userId      String
  title       String   // "Vacances", "Scolarité", "Urgence"
  emoji       String   @default("🎯")
  targetAmount Float
  currentAmount Float  @default(0)
  deadline    DateTime?
  status      String   @default("active") // active, completed, abandoned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Cagnotte {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  description String?
  emoji       String   @default("🎁")
  targetAmount Float
  currentAmount Float  @default(0)
  eventType   String   // mariage, deuil, fete, projet
  endDate     DateTime?
  shareLink   String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [creatorId], references: [id])
  contributions CagnotteContribution[]
}

model CagnotteContribution {
  id          String   @id @default(cuid())
  cagnotteId  String
  userId      String
  amount      Float
  message     String?
  createdAt   DateTime @default(now())

  cagnotte Cagnotte @relation(fields: [cagnotteId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  month       String   // "2025-01"
  totalAmount Float
  spentAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeType   String   // first_deposit, five_transfers, saver_bronze, saver_silver, saver_gold
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Tontine {
  id          String   @id @default(cuid())
  creatorId   String
  name        String
  amount      Float
  frequency   String   @default("monthly") // weekly, monthly
  maxMembers  Int
  currentTurn Int      @default(0)
  status      String   @default("active")
  inviteLink  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [creatorId], references: [id])
  members     TontineMember[]
}

model TontineMember {
  id          String   @id @default(cuid())
  tontineId   String
  userId      String
  paymentStatus String @default("pending") // pending, paid, late, skipped
  trustScore  Float    @default(100)
  joinedAt    DateTime @default(now())

  tontine Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model PayLink {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  currency    String   @default("XAF")
  description String?
  linkCode    String   @unique
  status      String   @default("active") // active, paid, expired, cancelled
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Credit {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  rate        Float
  duration    Int      // months
  monthlyPayment Float
  remaining   Float
  status      String   @default("pending") // pending, approved, active, repaid, rejected
  scoreUsed   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model MerchantProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  businessName String
  businessType String
  qrCode      String
  employeeCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model AgentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  agentName   String
  location    String
  latitude    Float?
  longitude   Float?
  commissionRate Float  @default(0.02)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Receipt {
  id          String   @id @default(cuid())
  userId      String
  transactionId String
  receiptNumber String  @unique
  createdAt   DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@unique([transactionId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // deposit, withdrawal, transfer, budget_alert, savings, credit, system
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  from        String
  to          String
  rate        Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
